# Supabase project settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Your single shared password, stored as plaintext. Anyone with read access
# to this env var (locally, or in Vercel's project settings) can read your
# login password directly, so treat it accordingly.
# If the password itself contains a literal $, escape each one as $$ —
# Next.js's .env loader (dotenv-expand) otherwise treats $ as the start of
# a variable reference and silently mangles the value.
AURORA_PASSWORD=Minnesota1

# Random secret used to sign the session cookie. 32+ random chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-with-a-long-random-string

# Shared secret Vercel Cron sends as "Authorization: Bearer <value>" when it
# triggers /api/cron/open-meteo. Generate the same way as SESSION_SECRET.
# Set it in Vercel's Environment Variables too, or the cron route will
# reject every request from Vercel's scheduler with 401.
CRON_SECRET=replace-with-a-long-random-string

# Sent as the User-Agent on every NWS (api.weather.gov) request, per NWS's
# own API etiquette guidance: they ask for an app name and a contact so they
# can reach you if a client misbehaves. Put your own contact here rather
# than leaving the placeholder — NWS may rate-limit or block unidentified
# clients during an incident.
NWS_USER_AGENT=(aurora-klax-app, replace-with-your-email@example.com)
