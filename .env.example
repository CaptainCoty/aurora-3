# Supabase project settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# bcrypt hash of your single shared password.
# Generate with: npm run hash-password -- "your-password-here"
AURORA_PASSWORD_HASH=$2a$12$replace-with-generated-hash

# Random secret used to sign the session cookie. 32+ random chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-with-a-long-random-string
